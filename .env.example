# Copy to .env and fill in. Never commit .env — it is gitignored.

# Where the SQLite database lives.
# Keep this OUT of Dropbox/OneDrive/iCloud: two machines syncing one SQLite
# file will corrupt it. See src/lib/db-location.ts, which warns at startup.
DATABASE_URL="file:./prisma/dev.db"

# Optional. A folder GeneNet reads documents from. The database does not live
# here — only attachments. Safe to point at a synced folder.
ONEDRIVE_PATH=""

# Signs session cookies. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out. Never reuse the value from another install.
SESSION_SECRET=""

# Outbound mail, for invitations and notifications. Leave blank to disable —
# invite codes can be copied out of the UI by hand instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# The address this install is reached at, used in invitation links.
SERVER_URL="http://localhost:3000"
