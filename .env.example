# Copy to .env and fill in. Never commit .env — it is gitignored.

# Where the SQLite database lives.
# Keep this OUT of Dropbox/OneDrive/iCloud: two machines syncing one SQLite
# file will corrupt it. See src/lib/db-location.ts, which warns at startup.
DATABASE_URL="file:./prisma/dev.db"

# Optional. A folder GeneNet reads documents from. The database does not live
# here — only attachments. Safe to point at a synced folder.
ONEDRIVE_PATH=""

# Signs session cookies. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out. Never reuse the value from another install.
SESSION_SECRET=""

# Outbound mail, for invitations and notifications. Leave blank to disable —
# invite codes can be copied out of the UI by hand instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# The address this install is reached at, used in invitation links.
SERVER_URL="http://localhost:3000"

# An address NCBI can reach about remote BLAST searches this server sends.
# NCBI asks every caller to identify itself; a caller they cannot contact is
# the first to be throttled or blocked, and the block lands on this
# institution's address rather than on one person. BLAST works without it.
NCBI_CONTACT_EMAIL=""

# Let webhooks post to addresses inside this machine or network. Off unless
# set to 1. Needed only while somebody is writing an integration against a
# script on their own laptop; a webhook URL is supplied by a person and
# fetched by this server, which is the shape of a server-side request forgery.
WEBHOOK_ALLOW_LOCAL=""

# Single sign-on with the institution's identity provider (OpenID Connect).
# Leave OIDC_ISSUER blank to keep password sign-in only. The redirect URI must
# be registered with the provider exactly as written here.
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost:3000/api/auth/sso/callback"
# What the button says: "Sign in with <this>".
OIDC_LABEL=""
# Extra scopes beyond openid, email and profile.
OIDC_SCOPES=""
# Make an account for somebody the lab has never seen, when the provider
# vouches for them. Off by default: on an issuer covering a whole university,
# every member of it could otherwise sign themselves in.
OIDC_CREATE_ACCOUNTS=""
