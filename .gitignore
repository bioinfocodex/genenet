# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# ─── added when the project was first committed ───

# SQLite databases are build artifacts, not source. They churn on every run,
# they carry seeded accounts, and a real deployment's copy must never reach a
# repository. Recreate with `npx prisma migrate dev` + `npx prisma db seed`.
*.db
*.db-journal
*.db-wal
*.db-shm

# Built installers. These are ~286 MB together and the AppImage alone is over
# GitHub's 100 MB per-file limit, so committing them makes the push fail.
# Publish them as release assets instead.
/public/releases/
