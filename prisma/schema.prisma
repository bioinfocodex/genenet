generator client {
  provider      = "prisma-client-js"
  // The client had been generated for "darwin" (Intel) on an arm64 Mac, so
  // every query failed at runtime with "could not locate the Query Engine for
  // runtime darwin-arm64" -- next build fell back to dynamic rendering and hid
  // it. Naming the target explicitly makes `prisma generate` fetch the right
  // engine regardless of which Node happens to be first on PATH.
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Moving to PostgreSQL
// -------------------
// SQLite is right for a lab running one server: with WAL enabled (see
// src/lib/sqlite-tuning.ts) it sustained ~18,000 writes and ~2,000 reads over
// three seconds on this schema, with reads never queueing behind a write. It
// stops being right at the point where the database must be reachable by more
// than one server process, because SQLite's locking is filesystem-local and
// cannot coordinate between machines.
//
// The switch is a configuration change rather than a rewrite:
//   1. provider = "postgresql" above
//   2. DATABASE_URL = postgresql://user:pass@host:5432/genenet
//   3. npx prisma migrate deploy
//
// Two things in the code assume SQLite and need attention first:
//   - src/lib/backup.ts uses VACUUM INTO for snapshots. Postgres wants
//     pg_dump instead.
//   - src/lib/sqlite-tuning.ts no-ops for non-file: URLs already, so it needs
//     nothing.
//
// Do this before selling a multi-seat install that is not one machine.

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         String   @default("MEMBER")
  status       String   @default("ACTIVE")  // ACTIVE | BLOCKED | REMOVED
  avatar       String?
  createdAt    DateTime @default(now())

  tasksAssigned      Task[]             @relation("AssignedTasks")
  tasksCreated       Task[]             @relation("CreatedTasks")
  taskComments       TaskComment[]      @relation("CommentAuthor")
  experiments        Experiment[]
  activities         Activity[]
  invitesSent        Invite[]           @relation("InviteCreator")
  proceduresAuthored Procedure[]        @relation("ProcedureAuthor")
  procedureVersions  ProcedureVersion[] @relation("VersionUpdatedBy")
  projectsCreated    Project[]          @relation("ProjectCreator")
  taskStepsCompleted TaskStep[]         @relation("StepCompletedBy")
  reportsCreated     Report[]           @relation("ReportCreator")
  simulations        Simulation[]       @relation("SimulationCreator")
  gelsCreated        GelSimulation[]    @relation("GelCreator")
  samplesCreated     Sample[]           @relation("SampleCreator")

  entityTypesCreated   EntityType[]    @relation("EntityTypeCreator")
  entitiesCreated      Entity[]        @relation("EntityCreator")
  resultSchemasCreated ResultSchema[]  @relation("ResultSchemaCreator")
  resultsRecorded      AssayResult[]   @relation("ResultRecorder")
  platesCreated        Plate[]         @relation("PlateCreator")
  transfersPerformed   PlateTransfer[] @relation("TransferPerformer")
  notebookAuthored     NotebookEntry[] @relation("NotebookAuthor")
  notebookSigned       NotebookEntry[] @relation("NotebookSigner")
  notebookWitnessed    NotebookEntry[] @relation("NotebookWitness")
  projectMemberships   ProjectMember[] @relation("ProjectMembership")
  projectMembersAdded  ProjectMember[] @relation("ProjectMemberAdder")
}

model WorkspaceSettings {
  id              String  @id @default("workspace")
  workspaceName   String  @default("GeneNet Lab")
  adminId         String
  isSetupComplete Boolean @default(false)
  storageNote     String?

  // Network / connection
  storageType     String  @default("local")    // local | network | cloud | onedrive
  storagePath     String?                       // e.g. /mnt/lab-data or D:/LabData
  systemId        String?                       // e.g. SYS-A3F2B1
  connectionCode  String?                       // e.g. LAB-48291
  serverUrl       String?                       // e.g. http://192.168.1.10:3000

  // Licensing / seat management
  companyName     String?
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  email       String?
  name        String?                           // pre-filled name for invitee
  usedAt      DateTime?
  usedByName  String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  emailSent   Boolean   @default(false)

  createdBy   User   @relation("InviteCreator", fields: [createdById], references: [id])
  createdById String
}

// ─── Procedures ──────────────────────────────────────────────────────────────

model Procedure {
  id           String   @id @default(cuid())
  procedureId  String   @unique  // PROC-0001
  name         String
  description  String?
  category     String   @default("General")
  version      String   @default("v1.0")
  status       String   @default("Draft")  // Draft | Review | Approved | Archived
  safetyNotes  String?
  reviewer     String?
  contributors String?  // comma-separated names
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author    User   @relation("ProcedureAuthor", fields: [authorId], references: [id])
  authorId  String

  steps     ProcedureStep[]
  materials ProcedureMaterial[]
  equipment ProcedureEquipment[]
  versions  ProcedureVersion[]
  tasks     Task[]
}

model ProcedureStep {
  id          String @id @default(cuid())
  stepNumber  Int
  title       String
  description String

  procedure   Procedure  @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  procedureId String

  taskSteps TaskStep[]
}

model ProcedureMaterial {
  id           String  @id @default(cuid())
  materialName String
  quantity     String?
  unit         String?

  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  procedureId String
}

model ProcedureEquipment {
  id            String @id @default(cuid())
  equipmentName String

  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  procedureId String
}

model ProcedureVersion {
  id            String   @id @default(cuid())
  versionNumber String
  changeLog     String
  updatedAt     DateTime @default(now())

  procedure   Procedure @relation(fields: [procedureId], references: [id])
  procedureId String

  updatedBy   User   @relation("VersionUpdatedBy", fields: [updatedById], references: [id])
  updatedById String
}

// ─── Projects & Tasks ────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("ACTIVE")  // ACTIVE | COMPLETED | ON_HOLD
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User   @relation("ProjectCreator", fields: [createdById], references: [id])
  createdById String

  tasks   Task[]
  report  Report?
  samples Sample[] @relation("SampleProject")

  entities  Entity[]        @relation("EntityProject")
  plates    Plate[]         @relation("PlateProject")
  notebook  NotebookEntry[] @relation("NotebookProject")
  members   ProjectMember[]
  /// When true, only users with a ProjectMember row may reach this project.
  restricted Boolean @default(false)
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("TODO")    // TODO | IN_PROGRESS | DONE
  priority    String    @default("MEDIUM")  // LOW | MEDIUM | HIGH
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignedTo   User?   @relation("AssignedTasks", fields: [assignedToId], references: [id])
  assignedToId String?

  createdBy   User?   @relation("CreatedTasks", fields: [createdById], references: [id])
  createdById String?

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  procedure   Procedure? @relation(fields: [procedureId], references: [id])
  procedureId String?

  geneSequence   GeneSequence? @relation("TaskSequences", fields: [geneSequenceId], references: [id])
  geneSequenceId String?

  // Execution fields
  result          String?
  success         Boolean?
  discussion      String?
  troubleshooting String?
  nextStep        String?
  attemptNumber   Int     @default(1)

  // Task iteration (repeat failed task)
  parentTask   Task?   @relation("TaskAttempts", fields: [parentTaskId], references: [id])
  parentTaskId String?
  childTasks   Task[]  @relation("TaskAttempts")

  steps       TaskStep[]
  reportLinks ReportTaskLink[]
  comments    TaskComment[]
  gelImages   GelImage[]
  samples     Sample[]         @relation("SampleTask")

  results AssayResult[] @relation("TaskResults")
}

model GelImage {
  id             String   @id @default(cuid())
  fileName       String
  filePath       String   // path under public/uploads/gels/
  fileType       String   // jpg | png | tif | other
  experimentType String?  // PCR | DIGESTION | LIGATION | OTHER
  notes          String?
  capturedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId String?
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  author   User   @relation("CommentAuthor", fields: [authorId], references: [id])
  authorId String
}

model TaskStep {
  id          String    @id @default(cuid())
  stepNumber  Int
  title       String
  description String
  status      String    @default("PENDING")  // PENDING | COMPLETED
  notes       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  sourceStep   ProcedureStep? @relation(fields: [sourceStepId], references: [id])
  sourceStepId String?

  completedBy   User?   @relation("StepCompletedBy", fields: [completedById], references: [id])
  completedById String?
}

// ─── Experiments ─────────────────────────────────────────────────────────────

model Experiment {
  id             String   @id @default(cuid())
  title          String
  protocol       String
  status         String   @default("PLANNED")
  resultData     String?
  expectedParams String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

/// A token that lets a script or instrument talk to this workspace.
///
/// Self-hosting is the reason to choose GeneNet over a cloud notebook, and an
/// API is what makes that pay off: a lab can wire a plate reader or a
/// sequencing pipeline straight into its own records, which no cloud vendor is
/// going to build for one lab.
///
/// The token itself is never stored. Only a SHA-256 of it is kept, the same
/// reasoning as passwords: a stolen database must not hand over working
/// credentials. The plaintext is shown once, at creation, and cannot be
/// recovered afterwards.
///
/// Every token belongs to a person. A request made with it is attributed to
/// them in the audit trail, so "the API changed it" is never the answer to who
/// changed a record.
model ApiToken {
  id        String    @id @default(cuid())
  /// Human label: "plate reader", "nanopore pipeline".
  name      String
  /// SHA-256 of the token, hex.
  tokenHash String    @unique
  /// First characters of the token, so a person can tell them apart in a list.
  prefix    String
  /// read | write. A write token can also read.
  scope     String    @default("read")

  ownerId    String
  ownerEmail String

  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([ownerId])
}

/// An electronic signature applied to a record.
///
/// 21 CFR Part 11 asks a signature to carry three things: who signed, when, and
/// what the signature *means* -- authorship is not approval, and approval is not
/// witnessing. It also has to be permanently linked to the record it signed, so
/// contentHash stores a digest of the record at the moment of signing. If the
/// record is edited afterwards the hash no longer matches, and the signature is
/// shown as applying to a superseded version rather than quietly appearing to
/// endorse text the signer never saw.
///
/// Signing re-checks the signer's password, which is the second authentication
/// component Part 11 requires at the moment of signing: the session proves who
/// is logged in, the password proves who is at the keyboard.
///
/// Like AuditLog, no foreign key to User: deleting a person must not delete the
/// evidence that they approved something.
model Signature {
  id       String   @id @default(cuid())
  at       DateTime @default(now())

  model    String   // Procedure | Experiment | Report
  recordId String

  /// authored | reviewed | approved | witnessed
  meaning  String

  signerId    String
  signerName  String
  signerEmail String

  /// Digest of the record's content when it was signed.
  contentHash String

  /// Optional remark, e.g. "approved with the deviation noted in step 4".
  note String?

  @@index([model, recordId])
  @@index([signerId])
}

/// Tamper-evident record of every change to workspace data.
///
/// Activity, below, is the human-readable feed shown in the UI: free text like
/// "created procedure". It cannot answer what a field held before an edit, who
/// changed it, or that a record was deleted at all, which is what an audit
/// trail has to do -- and what 21 CFR Part 11 asks for when it says a
/// computer-generated, time-stamped record of creation, modification and
/// deletion. The two are kept apart because they serve different readers.
///
/// Written by the Prisma extension in src/lib/audit.ts rather than by callers,
/// so coverage cannot drift as new actions are added.
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())

  action   String   // create | update | delete
  model    String   // Task, Sample, Procedure, ...
  recordId String?  // null for bulk operations
  rows     Int      @default(1) // >1 for updateMany / deleteMany

  /// No relation to User on purpose. A foreign key would let deleting a person
  /// cascade away the evidence of what they did, and the email is denormalised
  /// so the trail still names them after their account is gone.
  actorId    String?
  actorEmail String?

  /// JSON. Null on create (nothing before) and on delete (nothing after).
  before String?
  after  String?

  @@index([at])
  @@index([model, recordId])
  @@index([actorId])
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  target    String
  timestamp DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model GeneSequence {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   @default("gene")
  sequence    String
  size        Int
  tags        String?
  features    String?  @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  primers     Primer[]
  simulations Simulation[]
  proteins    Protein[]    @relation("ProteinFromGene")
  tasks       Task[]       @relation("TaskSequences")
  samples     Sample[]     @relation("SampleSequence")
  lineage     SequenceLineage[] @relation("LineageChild")

  wells PlateWell[] @relation("SequenceWells")
}

model Primer {
  id        String  @id @default(cuid())
  name      String
  sequence  String
  direction String  @default("forward")  // forward | reverse
  tm        Float?
  gcContent Float?
  notes     String?
  createdAt DateTime @default(now())

  geneSequence   GeneSequence @relation(fields: [geneSequenceId], references: [id], onDelete: Cascade)
  geneSequenceId String
}

model Simulation {
  id         String   @id @default(cuid())
  type       String   // PCR | DIGESTION | LIGATION
  name       String   @default("")
  inputData  String   // JSON
  outputData String   // JSON
  createdAt  DateTime @default(now())

  createdBy   User   @relation("SimulationCreator", fields: [createdById], references: [id])
  createdById String

  geneSequence   GeneSequence? @relation(fields: [geneSequenceId], references: [id])
  geneSequenceId String?
}

// ─── Reports ─────────────────────────────────────────────────────────────────

model Report {
  id        String   @id @default(cuid())
  title     String
  status    String   @default("Draft")   // Draft | In Progress | Completed
  abstract  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id])
  projectId String  @unique

  createdBy   User   @relation("ReportCreator", fields: [createdById], references: [id])
  createdById String

  sections  ReportSection[]
  figures   ReportFigure[]
  tables    ReportTable[]
  taskLinks ReportTaskLink[]
}

model ReportSection {
  id          String @id @default(cuid())
  sectionKey  String  // e.g. "gene_info", "expected_results", "discussion"
  title       String
  content     String @default("")
  order       Int    @default(0)

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String
}

model ReportFigure {
  id       String @id @default(cuid())
  imageUrl String?
  title    String @default("")
  legend   String @default("")
  order    Int    @default(0)

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String
}

model ReportTable {
  id        String @id @default(cuid())
  tableData String @default("[]")  // JSON: string[][]
  title     String @default("")
  legend    String @default("")
  order     Int    @default(0)

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String
}

model ReportTaskLink {
  id     String @id @default(cuid())

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String

  task   Task   @relation(fields: [taskId], references: [id])
  taskId String

  @@unique([reportId, taskId])
}

// ─── Protein Module ───────────────────────────────────────────────────────────

model Protein {
  id             String   @id @default(cuid())
  name           String
  sequence       String   // one-letter amino acid codes
  description    String?
  tags           String?
  mw             Float?   // molecular weight in Da
  isoelectric    Float?   // pI
  gravy          Float?   // grand average hydropathicity
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  geneSequence   GeneSequence? @relation("ProteinFromGene", fields: [geneSequenceId], references: [id])
  geneSequenceId String?
}

// ─── Collections ──────────────────────────────────────────────────────────────

model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       CollectionItem[]
}

model CollectionItem {
  id           String   @id @default(cuid())
  itemType     String   // 'sequence' | 'primer' | 'protein'
  itemId       String
  notes        String?
  addedAt      DateTime @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String

  @@unique([collectionId, itemType, itemId])
}

// ─── Bioreactors ──────────────────────────────────────────────────────────────

model BioreactorRun {
  id          String    @id @default(cuid())
  name        String
  vesselSize  String    @default("2L")   // 2L | 10L | custom
  organism    String?
  medium      String?
  status      String    @default("RUNNING")  // RUNNING | COMPLETED | FAILED | PAUSED
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  readings    BioreactorReading[]
}

model BioreactorReading {
  id          String   @id @default(cuid())
  elapsedHrs  Float
  ph          Float?
  temperature Float?
  dissolvedO2 Float?
  feedRate    Float?
  agitation   Int?
  od600       Float?
  notes       String?
  recordedAt  DateTime @default(now())

  run   BioreactorRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String
}

// ─── Gel Simulations ─────────────────────────────────────────────────────────

model GelSimulation {
  id            String   @id @default(cuid())
  name          String   @default("Untitled Gel")
  concentration Float    @default(1.0)  // % agarose
  voltage       Int      @default(100)  // volts
  runTime       Int      @default(30)   // minutes
  lanes         String   @default("[]") // JSON array of lanes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy   User   @relation("GelCreator", fields: [createdById], references: [id])
  createdById String
}

// ─── Sample Storage ───────────────────────────────────────────────────────────

model Freezer {
  id          String   @id @default(cuid())
  name        String
  temperature Int      // -20 or -80 (°C)
  location    String?  // e.g. "Lab Room 2, West Wall"
  notes       String?
  createdAt   DateTime @default(now())

  samples Sample[]
}

model Sample {
  id          String   @id @default(cuid())
  sampleId    String   @unique  // auto-generated e.g. PLA-001
  name        String
  type        String   // PLASMID | LINEAR_DNA | GLYCEROL_STOCK | OTHER
  status      String   @default("ACTIVE") // ACTIVE | USED | DEPLETED | ARCHIVED
  description String?
  notes       String?

  // Storage location
  freezer     Freezer? @relation(fields: [freezerId], references: [id])
  freezerId   String?
  rack        String?
  box         String?
  position    String?  // e.g. A1, B3

  // Linkages
  task          Task?         @relation("SampleTask", fields: [taskId], references: [id])
  taskId        String?
  project       Project?      @relation("SampleProject", fields: [projectId], references: [id])
  projectId     String?
  geneSequence  GeneSequence? @relation("SampleSequence", fields: [geneSequenceId], references: [id])
  geneSequenceId String?

  createdBy   User?   @relation("SampleCreator", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wells   PlateWell[]   @relation("SampleWells")
  results AssayResult[] @relation("SampleResults")
}

/**
 * Where a construct came from.
 *
 * One row per parent, so a three-part assembly records three. The parent's name
 * is kept alongside its id because a lineage that forgets what a deleted parent
 * was called is worse than no lineage: it shows a gap where there was a
 * decision. The id may dangle; the name never does.
 */
model SequenceLineage {
  id          String   @id @default(cuid())

  child       GeneSequence @relation("LineageChild", fields: [childId], references: [id], onDelete: Cascade)
  childId     String

  /** Null once the parent record is gone. The name survives regardless. */
  parentId    String?
  parentName  String

  /** How the child was made: "Gibson Assembly", "Golden Gate (BsaI)", "import". */
  method      String

  createdAt   DateTime @default(now())
  createdById String?

  @@index([childId])
  @@index([parentId])
}

/**
 * A part the lab has taught the system to recognise.
 *
 * Kept apart from the shipped library rather than merged into it, so it is
 * always clear which parts came with the software and which came from a file
 * somebody imported. The uniqueness is on name and sequence together: two parts
 * may share a name when one is a variant of the other, and keeping both is the
 * point -- what must not happen is the same bases stored twice.
 */
model LibraryPart {
  id          String   @id @default(cuid())
  name        String
  type        String
  color       String
  sequence    String
  note        String?

  /** Which sequence it was taken from, when it came from an import. */
  sourceId    String?
  sourceName  String?

  createdAt   DateTime @default(now())
  createdById String?

  @@unique([name, sequence])
  @@index([name])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 7: the parts that make this a system of record rather than a tool.
// ─────────────────────────────────────────────────────────────────────────────

/**
 * A record type the lab defines for itself.
 *
 * Every other model in this schema is a decision made here about what a lab
 * keeps track of. That works until a lab tracks something nobody anticipated --
 * an antibody, a cell line, a mouse colony, a plasmid prep batch -- and then
 * the only options are to misuse an existing model or to wait for a release.
 *
 * An EntityType lets the lab declare the shape itself: a name, and a set of
 * typed fields. Instances are Entity rows, and their values are FieldValue
 * rows in typed columns, so a custom field is as queryable as a built-in one.
 *
 * This deliberately does not convert the existing models. A Sample knows about
 * freezers and a GeneSequence knows about bases; folding them into generic
 * entities would trade real, specific behaviour for uniformity nobody asked
 * for. Custom types sit alongside them and can link to them.
 */
model EntityType {
  id          String  @id @default(cuid())
  name        String  @unique
  plural      String
  description String?

  /// Prefix for generated codes, e.g. "STR" gives STR-001. Immutable once set:
  /// codes already printed on tubes must keep meaning what they meant.
  prefix      String  @unique
  color       String  @default("#3b82f6")
  icon        String?
  archived    Boolean @default(false)

  createdBy   User?   @relation("EntityTypeCreator", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields   FieldDef[] @relation("EntityTypeFields")
  entities Entity[]
  /// Field definitions on other types that point at this one.
  linkedFrom FieldDef[] @relation("FieldLinkTarget")
}

/**
 * One typed field, belonging to either an entity type or a result schema.
 *
 * Exactly one of entityTypeId / resultSchemaId is set. SQLite cannot express
 * that as a constraint, so it is enforced in src/lib/fields.ts and checked on
 * every write; the alternative was two near-identical tables and two
 * near-identical validators, which is how the two drift apart.
 */
model FieldDef {
  id    String @id @default(cuid())
  /// Stable identifier used by values. Never changes once created, so renaming
  /// a field's label does not orphan everything recorded under it.
  key   String
  label String

  /// text | longtext | number | integer | boolean | date | select | multiselect
  /// | link | sequence | sample
  type     String
  required Boolean @default(false)
  /// Values must be distinct across instances of this type.
  isUnique Boolean @default(false)

  /// JSON array of permitted options, for select and multiselect.
  options  String?
  /// For link fields: the entity type this points at.
  linkType   EntityType? @relation("FieldLinkTarget", fields: [linkTypeId], references: [id])
  linkTypeId String?

  unit     String?
  helpText String?
  order    Int     @default(0)

  entityType   EntityType? @relation("EntityTypeFields", fields: [entityTypeId], references: [id], onDelete: Cascade)
  entityTypeId String?
  resultSchema   ResultSchema? @relation(fields: [resultSchemaId], references: [id], onDelete: Cascade)
  resultSchemaId String?

  values FieldValue[]

  @@unique([entityTypeId, key])
  @@unique([resultSchemaId, key])
  @@index([entityTypeId])
  @@index([resultSchemaId])
}

/** One instance of a lab-defined type. */
model Entity {
  id   String @id @default(cuid())
  /// Generated from the type's prefix, e.g. STR-001. Shown on labels.
  code String @unique
  name String
  archived Boolean @default(false)

  entityType   EntityType @relation(fields: [entityTypeId], references: [id], onDelete: Cascade)
  entityTypeId String

  project   Project? @relation("EntityProject", fields: [projectId], references: [id])
  projectId String?

  createdBy   User?    @relation("EntityCreator", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  values  FieldValue[]
  wells   PlateWell[]
  results AssayResult[] @relation("EntityResults")
  /// Field values on other entities that point at this one.
  referencedBy FieldValue[] @relation("FieldValueRef")

  @@index([entityTypeId, archived])
  @@index([name])
}

/**
 * One value of one field, on one entity or one result.
 *
 * Values live in typed columns rather than a single JSON blob so that "every
 * strain with an OD above 0.8" is a query rather than a scan. The cost is a
 * row per field per record, which for a lab's scale is nothing.
 */
model FieldValue {
  id      String   @id @default(cuid())
  field   FieldDef @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId String

  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId String?
  result   AssayResult? @relation(fields: [resultId], references: [id], onDelete: Cascade)
  resultId String?

  text    String?
  number  Float?
  boolean Boolean?
  date    DateTime?

  /// Target of a link, sequence or sample field. `text` holds the display name
  /// as it was at the time of writing, so a deleted target still reads as
  /// something rather than as a dangling id.
  refEntity   Entity? @relation("FieldValueRef", fields: [refEntityId], references: [id])
  refEntityId String?
  refId       String?

  @@unique([entityId, fieldId])
  @@unique([resultId, fieldId])
  @@index([fieldId, number])
  @@index([fieldId, text])
}

/**
 * The shape of a measurement, so results can be queried rather than read.
 *
 * A result recorded as free text is a result nobody can plot. Declaring the
 * columns up front -- OD600 as a number, "passed" as a boolean, operator as
 * text -- means a year of assays can be compared without anyone re-reading
 * them.
 */
model ResultSchema {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  archived    Boolean @default(false)

  createdBy   User?    @relation("ResultSchemaCreator", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields  FieldDef[]
  results AssayResult[]
}

/** One measurement, attached to whatever it was measured on. */
model AssayResult {
  id       String @id @default(cuid())
  schema   ResultSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  schemaId String

  /// What was measured. At most one of these is set; all may be null for a
  /// result recorded before it was attached to anything.
  sample   Sample? @relation("SampleResults", fields: [sampleId], references: [id])
  sampleId String?
  well     PlateWell? @relation(fields: [wellId], references: [id], onDelete: Cascade)
  wellId   String?
  task     Task? @relation("TaskResults", fields: [taskId], references: [id])
  taskId   String?
  entity   Entity? @relation("EntityResults", fields: [entityId], references: [id])
  entityId String?

  measuredAt  DateTime @default(now())
  recordedBy   User?   @relation("ResultRecorder", fields: [recordedById], references: [id])
  recordedById String?
  createdAt   DateTime @default(now())

  values FieldValue[]

  @@index([schemaId, measuredAt])
  @@index([sampleId])
  @@index([wellId])
}

/**
 * A microplate.
 *
 * Freezer / rack / box / position describes where one tube sits. It cannot
 * describe a screen, where the identity of a well is its coordinates and the
 * whole point is that ninety-six of them were handled as one object.
 */
model Plate {
  id      String  @id @default(cuid())
  name    String
  barcode String? @unique
  /// 6 | 12 | 24 | 48 | 96 | 384 | 1536
  format  Int     @default(96)
  description String?
  archived Boolean @default(false)

  project   Project? @relation("PlateProject", fields: [projectId], references: [id])
  projectId String?

  createdBy   User?    @relation("PlateCreator", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wells         PlateWell[]
  transfersOut  PlateTransfer[] @relation("TransferSource")
  transfersIn   PlateTransfer[] @relation("TransferDest")
}

/**
 * One well.
 *
 * Rows are created for every well when the plate is made, empty ones included:
 * an empty well is a fact about the plate, and a layout with gaps in it is a
 * layout, not missing data.
 */
model PlateWell {
  id      String @id @default(cuid())
  plate   Plate  @relation(fields: [plateId], references: [id], onDelete: Cascade)
  plateId String

  /// 0-indexed. Row 0 column 0 is A1.
  row   Int
  col   Int
  label String

  sample   Sample? @relation("SampleWells", fields: [sampleId], references: [id])
  sampleId String?
  entity   Entity? @relation(fields: [entityId], references: [id])
  entityId String?
  sequence   GeneSequence? @relation("SequenceWells", fields: [sequenceId], references: [id])
  sequenceId String?

  /// What is in the well when it is not a record the system already holds.
  content String?
  /// Free-text grouping used to colour a plate map: "control", "10 µM", etc.
  role    String?

  volumeUl      Float?
  concentration Float?
  concentrationUnit String?
  notes String?

  results AssayResult[]
  sourceOf PlateTransferWell[] @relation("TransferFromWell")
  destOf   PlateTransferWell[] @relation("TransferToWell")

  @@unique([plateId, row, col])
  @@index([plateId])
  @@index([sampleId])
}

/** A recorded movement of material from one plate to another. */
model PlateTransfer {
  id String @id @default(cuid())

  source   Plate  @relation("TransferSource", fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId String
  dest     Plate  @relation("TransferDest", fields: [destId], references: [id], onDelete: Cascade)
  destId   String

  /// stamp | cherry-pick | pool | dilution
  kind     String @default("stamp")
  volumeUl Float?
  note     String?

  performedBy   User?    @relation("TransferPerformer", fields: [performedById], references: [id])
  performedById String?
  performedAt   DateTime @default(now())

  wells PlateTransferWell[]

  @@index([sourceId])
  @@index([destId])
}

/**
 * One well-to-well step of a transfer.
 *
 * Stored per well rather than as a rule, because "which wells did this sample
 * end up in" is the question a transfer record exists to answer, and a rule has
 * to be re-run to answer it.
 */
model PlateTransferWell {
  id         String @id @default(cuid())
  transfer   PlateTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  transferId String

  from   PlateWell @relation("TransferFromWell", fields: [fromId], references: [id], onDelete: Cascade)
  fromId String
  to     PlateWell @relation("TransferToWell", fields: [toId], references: [id], onDelete: Cascade)
  toId   String

  volumeUl Float?

  @@index([transferId])
  @@index([fromId])
  @@index([toId])
}

/**
 * What actually happened, as opposed to what was planned.
 *
 * Procedures describe intent and are versioned. A notebook entry is dated,
 * written after the fact, and signed -- and once signed it stops being
 * editable, because a signature over content that can still change is not a
 * signature. Edits after signing are made as a new entry that supersedes it,
 * which is what a paper notebook enforces with bound pages.
 */
model NotebookEntry {
  id      String @id @default(cuid())
  title   String
  /// Markdown. Rendered read-only once signed.
  body    String @default("")
  /// The day the work was done, which is not the day the entry was typed.
  entryDate DateTime

  /// DRAFT | SIGNED | WITNESSED
  status  String @default("DRAFT")

  author   User   @relation("NotebookAuthor", fields: [authorId], references: [id])
  authorId String

  project   Project? @relation("NotebookProject", fields: [projectId], references: [id])
  projectId String?

  /// Digest of title + body + entryDate at the moment of signing. Recomputing
  /// it is how a later reader checks the entry has not been altered since.
  contentHash String?
  signedAt    DateTime?
  signedBy    User?    @relation("NotebookSigner", fields: [signedById], references: [id])
  signedById  String?
  witnessedAt   DateTime?
  witnessedBy   User?   @relation("NotebookWitness", fields: [witnessedById], references: [id])
  witnessedById String?

  /// Set when this entry corrects one that was already signed.
  supersedes   NotebookEntry? @relation("Supersedes", fields: [supersedesId], references: [id])
  supersedesId String?
  supersededBy NotebookEntry[] @relation("Supersedes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links NotebookLink[]

  @@index([authorId, entryDate])
  @@index([projectId])
  @@index([status])
}

/** Something an entry points at: a sequence, a sample, a plate, a result. */
model NotebookLink {
  id      String @id @default(cuid())
  entry   NotebookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String

  /// sequence | sample | plate | result | task | entity | procedure | gel
  kind     String
  targetId String
  /// The target's name when the link was made, so a deleted target still reads.
  label    String

  @@index([entryId])
  @@index([kind, targetId])
}

/**
 * Who may see and change what, below the level of workspace role.
 *
 * ADMIN and MEMBER answer "does this person work here". They cannot answer the
 * question a lab actually has once a rotation student or an external
 * collaborator arrives: this person should see one project and nothing else.
 *
 * Absence of a row is not absence of access -- a workspace member can still
 * reach anything not explicitly restricted. Making every project private by
 * default would break every existing install on upgrade, so a project opts in
 * by being marked restricted, and only then do these rows decide.
 */
model ProjectMember {
  id        String @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User    @relation("ProjectMembership", fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  /// VIEW | EDIT | MANAGE
  level String @default("VIEW")

  addedBy   User?    @relation("ProjectMemberAdder", fields: [addedById], references: [id])
  addedById String?
  addedAt   DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}
