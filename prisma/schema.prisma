generator client {
  provider      = "prisma-client-js"
  // The client had been generated for "darwin" (Intel) on an arm64 Mac, so
  // every query failed at runtime with "could not locate the Query Engine for
  // runtime darwin-arm64" -- next build fell back to dynamic rendering and hid
  // it. Naming the target explicitly makes `prisma generate` fetch the right
  // engine regardless of which Node happens to be first on PATH.
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Moving to PostgreSQL
// -------------------
// SQLite is right for a lab running one server: with WAL enabled (see
// src/lib/sqlite-tuning.ts) it sustained ~18,000 writes and ~2,000 reads over
// three seconds on this schema, with reads never queueing behind a write. It
// stops being right at the point where the database must be reachable by more
// than one server process, because SQLite's locking is filesystem-local and
// cannot coordinate between machines.
//
// The switch is a configuration change rather than a rewrite:
//   1. provider = "postgresql" above
//   2. DATABASE_URL = postgresql://user:pass@host:5432/genenet
//   3. npx prisma migrate deploy
//
// Two things in the code assume SQLite and need attention first:
//   - src/lib/backup.ts uses VACUUM INTO for snapshots. Postgres wants
//     pg_dump instead.
//   - src/lib/sqlite-tuning.ts no-ops for non-file: URLs already, so it needs
//     nothing.
//
// Do this before selling a multi-seat install that is not one machine.

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         String   @default("MEMBER")
  status       String   @default("ACTIVE")  // ACTIVE | BLOCKED | REMOVED
  avatar       String?
  createdAt    DateTime @default(now())

  tasksAssigned      Task[]             @relation("AssignedTasks")
  tasksCreated       Task[]             @relation("CreatedTasks")
  taskComments       TaskComment[]      @relation("CommentAuthor")
  experiments        Experiment[]
  activities         Activity[]
  invitesSent        Invite[]           @relation("InviteCreator")
  proceduresAuthored Procedure[]        @relation("ProcedureAuthor")
  procedureVersions  ProcedureVersion[] @relation("VersionUpdatedBy")
  projectsCreated    Project[]          @relation("ProjectCreator")
  taskStepsCompleted TaskStep[]         @relation("StepCompletedBy")
  reportsCreated     Report[]           @relation("ReportCreator")
  simulations        Simulation[]       @relation("SimulationCreator")
  gelsCreated        GelSimulation[]    @relation("GelCreator")
  samplesCreated     Sample[]           @relation("SampleCreator")
}

model WorkspaceSettings {
  id              String  @id @default("workspace")
  workspaceName   String  @default("GeneNet Lab")
  adminId         String
  isSetupComplete Boolean @default(false)
  storageNote     String?

  // Network / connection
  storageType     String  @default("local")    // local | network | cloud | onedrive
  storagePath     String?                       // e.g. /mnt/lab-data or D:/LabData
  systemId        String?                       // e.g. SYS-A3F2B1
  connectionCode  String?                       // e.g. LAB-48291
  serverUrl       String?                       // e.g. http://192.168.1.10:3000

  // Licensing / seat management
  plan            String  @default("starter")  // starter | pro | enterprise
  seatLimit       Int     @default(5)
  companyName     String?
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  email       String?
  name        String?                           // pre-filled name for invitee
  usedAt      DateTime?
  usedByName  String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  emailSent   Boolean   @default(false)

  createdBy   User   @relation("InviteCreator", fields: [createdById], references: [id])
  createdById String
}

// ─── Procedures ──────────────────────────────────────────────────────────────

model Procedure {
  id           String   @id @default(cuid())
  procedureId  String   @unique  // PROC-0001
  name         String
  description  String?
  category     String   @default("General")
  version      String   @default("v1.0")
  status       String   @default("Draft")  // Draft | Review | Approved | Archived
  safetyNotes  String?
  reviewer     String?
  contributors String?  // comma-separated names
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author    User   @relation("ProcedureAuthor", fields: [authorId], references: [id])
  authorId  String

  steps     ProcedureStep[]
  materials ProcedureMaterial[]
  equipment ProcedureEquipment[]
  versions  ProcedureVersion[]
  tasks     Task[]
}

model ProcedureStep {
  id          String @id @default(cuid())
  stepNumber  Int
  title       String
  description String

  procedure   Procedure  @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  procedureId String

  taskSteps TaskStep[]
}

model ProcedureMaterial {
  id           String  @id @default(cuid())
  materialName String
  quantity     String?
  unit         String?

  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  procedureId String
}

model ProcedureEquipment {
  id            String @id @default(cuid())
  equipmentName String

  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  procedureId String
}

model ProcedureVersion {
  id            String   @id @default(cuid())
  versionNumber String
  changeLog     String
  updatedAt     DateTime @default(now())

  procedure   Procedure @relation(fields: [procedureId], references: [id])
  procedureId String

  updatedBy   User   @relation("VersionUpdatedBy", fields: [updatedById], references: [id])
  updatedById String
}

// ─── Projects & Tasks ────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("ACTIVE")  // ACTIVE | COMPLETED | ON_HOLD
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User   @relation("ProjectCreator", fields: [createdById], references: [id])
  createdById String

  tasks   Task[]
  report  Report?
  samples Sample[] @relation("SampleProject")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("TODO")    // TODO | IN_PROGRESS | DONE
  priority    String    @default("MEDIUM")  // LOW | MEDIUM | HIGH
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignedTo   User?   @relation("AssignedTasks", fields: [assignedToId], references: [id])
  assignedToId String?

  createdBy   User?   @relation("CreatedTasks", fields: [createdById], references: [id])
  createdById String?

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  procedure   Procedure? @relation(fields: [procedureId], references: [id])
  procedureId String?

  geneSequence   GeneSequence? @relation("TaskSequences", fields: [geneSequenceId], references: [id])
  geneSequenceId String?

  // Execution fields
  result          String?
  success         Boolean?
  discussion      String?
  troubleshooting String?
  nextStep        String?
  attemptNumber   Int     @default(1)

  // Task iteration (repeat failed task)
  parentTask   Task?   @relation("TaskAttempts", fields: [parentTaskId], references: [id])
  parentTaskId String?
  childTasks   Task[]  @relation("TaskAttempts")

  steps       TaskStep[]
  reportLinks ReportTaskLink[]
  comments    TaskComment[]
  gelImages   GelImage[]
  samples     Sample[]         @relation("SampleTask")
}

model GelImage {
  id             String   @id @default(cuid())
  fileName       String
  filePath       String   // path under public/uploads/gels/
  fileType       String   // jpg | png | tif | other
  experimentType String?  // PCR | DIGESTION | LIGATION | OTHER
  notes          String?
  capturedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId String?
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  author   User   @relation("CommentAuthor", fields: [authorId], references: [id])
  authorId String
}

model TaskStep {
  id          String    @id @default(cuid())
  stepNumber  Int
  title       String
  description String
  status      String    @default("PENDING")  // PENDING | COMPLETED
  notes       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  sourceStep   ProcedureStep? @relation(fields: [sourceStepId], references: [id])
  sourceStepId String?

  completedBy   User?   @relation("StepCompletedBy", fields: [completedById], references: [id])
  completedById String?
}

// ─── Experiments ─────────────────────────────────────────────────────────────

model Experiment {
  id             String   @id @default(cuid())
  title          String
  protocol       String
  status         String   @default("PLANNED")
  resultData     String?
  expectedParams String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

/// A token that lets a script or instrument talk to this workspace.
///
/// Self-hosting is the reason to choose GeneNet over a cloud notebook, and an
/// API is what makes that pay off: a lab can wire a plate reader or a
/// sequencing pipeline straight into its own records, which no cloud vendor is
/// going to build for one lab.
///
/// The token itself is never stored. Only a SHA-256 of it is kept, the same
/// reasoning as passwords: a stolen database must not hand over working
/// credentials. The plaintext is shown once, at creation, and cannot be
/// recovered afterwards.
///
/// Every token belongs to a person. A request made with it is attributed to
/// them in the audit trail, so "the API changed it" is never the answer to who
/// changed a record.
model ApiToken {
  id        String    @id @default(cuid())
  /// Human label: "plate reader", "nanopore pipeline".
  name      String
  /// SHA-256 of the token, hex.
  tokenHash String    @unique
  /// First characters of the token, so a person can tell them apart in a list.
  prefix    String
  /// read | write. A write token can also read.
  scope     String    @default("read")

  ownerId    String
  ownerEmail String

  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([ownerId])
}

/// An electronic signature applied to a record.
///
/// 21 CFR Part 11 asks a signature to carry three things: who signed, when, and
/// what the signature *means* -- authorship is not approval, and approval is not
/// witnessing. It also has to be permanently linked to the record it signed, so
/// contentHash stores a digest of the record at the moment of signing. If the
/// record is edited afterwards the hash no longer matches, and the signature is
/// shown as applying to a superseded version rather than quietly appearing to
/// endorse text the signer never saw.
///
/// Signing re-checks the signer's password, which is the second authentication
/// component Part 11 requires at the moment of signing: the session proves who
/// is logged in, the password proves who is at the keyboard.
///
/// Like AuditLog, no foreign key to User: deleting a person must not delete the
/// evidence that they approved something.
model Signature {
  id       String   @id @default(cuid())
  at       DateTime @default(now())

  model    String   // Procedure | Experiment | Report
  recordId String

  /// authored | reviewed | approved | witnessed
  meaning  String

  signerId    String
  signerName  String
  signerEmail String

  /// Digest of the record's content when it was signed.
  contentHash String

  /// Optional remark, e.g. "approved with the deviation noted in step 4".
  note String?

  @@index([model, recordId])
  @@index([signerId])
}

/// Tamper-evident record of every change to workspace data.
///
/// Activity, below, is the human-readable feed shown in the UI: free text like
/// "created procedure". It cannot answer what a field held before an edit, who
/// changed it, or that a record was deleted at all, which is what an audit
/// trail has to do -- and what 21 CFR Part 11 asks for when it says a
/// computer-generated, time-stamped record of creation, modification and
/// deletion. The two are kept apart because they serve different readers.
///
/// Written by the Prisma extension in src/lib/audit.ts rather than by callers,
/// so coverage cannot drift as new actions are added.
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())

  action   String   // create | update | delete
  model    String   // Task, Sample, Procedure, ...
  recordId String?  // null for bulk operations
  rows     Int      @default(1) // >1 for updateMany / deleteMany

  /// No relation to User on purpose. A foreign key would let deleting a person
  /// cascade away the evidence of what they did, and the email is denormalised
  /// so the trail still names them after their account is gone.
  actorId    String?
  actorEmail String?

  /// JSON. Null on create (nothing before) and on delete (nothing after).
  before String?
  after  String?

  @@index([at])
  @@index([model, recordId])
  @@index([actorId])
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  target    String
  timestamp DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model GeneSequence {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   @default("gene")
  sequence    String
  size        Int
  tags        String?
  features    String?  @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  primers     Primer[]
  simulations Simulation[]
  proteins    Protein[]    @relation("ProteinFromGene")
  tasks       Task[]       @relation("TaskSequences")
  samples     Sample[]     @relation("SampleSequence")
}

model Primer {
  id        String  @id @default(cuid())
  name      String
  sequence  String
  direction String  @default("forward")  // forward | reverse
  tm        Float?
  gcContent Float?
  notes     String?
  createdAt DateTime @default(now())

  geneSequence   GeneSequence @relation(fields: [geneSequenceId], references: [id], onDelete: Cascade)
  geneSequenceId String
}

model Simulation {
  id         String   @id @default(cuid())
  type       String   // PCR | DIGESTION | LIGATION
  name       String   @default("")
  inputData  String   // JSON
  outputData String   // JSON
  createdAt  DateTime @default(now())

  createdBy   User   @relation("SimulationCreator", fields: [createdById], references: [id])
  createdById String

  geneSequence   GeneSequence? @relation(fields: [geneSequenceId], references: [id])
  geneSequenceId String?
}

// ─── Reports ─────────────────────────────────────────────────────────────────

model Report {
  id        String   @id @default(cuid())
  title     String
  status    String   @default("Draft")   // Draft | In Progress | Completed
  abstract  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id])
  projectId String  @unique

  createdBy   User   @relation("ReportCreator", fields: [createdById], references: [id])
  createdById String

  sections  ReportSection[]
  figures   ReportFigure[]
  tables    ReportTable[]
  taskLinks ReportTaskLink[]
}

model ReportSection {
  id          String @id @default(cuid())
  sectionKey  String  // e.g. "gene_info", "expected_results", "discussion"
  title       String
  content     String @default("")
  order       Int    @default(0)

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String
}

model ReportFigure {
  id       String @id @default(cuid())
  imageUrl String?
  title    String @default("")
  legend   String @default("")
  order    Int    @default(0)

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String
}

model ReportTable {
  id        String @id @default(cuid())
  tableData String @default("[]")  // JSON: string[][]
  title     String @default("")
  legend    String @default("")
  order     Int    @default(0)

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String
}

model ReportTaskLink {
  id     String @id @default(cuid())

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String

  task   Task   @relation(fields: [taskId], references: [id])
  taskId String

  @@unique([reportId, taskId])
}

// ─── Protein Module ───────────────────────────────────────────────────────────

model Protein {
  id             String   @id @default(cuid())
  name           String
  sequence       String   // one-letter amino acid codes
  description    String?
  tags           String?
  mw             Float?   // molecular weight in Da
  isoelectric    Float?   // pI
  gravy          Float?   // grand average hydropathicity
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  geneSequence   GeneSequence? @relation("ProteinFromGene", fields: [geneSequenceId], references: [id])
  geneSequenceId String?
}

// ─── Collections ──────────────────────────────────────────────────────────────

model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       CollectionItem[]
}

model CollectionItem {
  id           String   @id @default(cuid())
  itemType     String   // 'sequence' | 'primer' | 'protein'
  itemId       String
  notes        String?
  addedAt      DateTime @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String

  @@unique([collectionId, itemType, itemId])
}

// ─── Bioreactors ──────────────────────────────────────────────────────────────

model BioreactorRun {
  id          String    @id @default(cuid())
  name        String
  vesselSize  String    @default("2L")   // 2L | 10L | custom
  organism    String?
  medium      String?
  status      String    @default("RUNNING")  // RUNNING | COMPLETED | FAILED | PAUSED
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  readings    BioreactorReading[]
}

model BioreactorReading {
  id          String   @id @default(cuid())
  elapsedHrs  Float
  ph          Float?
  temperature Float?
  dissolvedO2 Float?
  feedRate    Float?
  agitation   Int?
  od600       Float?
  notes       String?
  recordedAt  DateTime @default(now())

  run   BioreactorRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String
}

// ─── Gel Simulations ─────────────────────────────────────────────────────────

model GelSimulation {
  id            String   @id @default(cuid())
  name          String   @default("Untitled Gel")
  concentration Float    @default(1.0)  // % agarose
  voltage       Int      @default(100)  // volts
  runTime       Int      @default(30)   // minutes
  lanes         String   @default("[]") // JSON array of lanes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy   User   @relation("GelCreator", fields: [createdById], references: [id])
  createdById String
}

// ─── Sample Storage ───────────────────────────────────────────────────────────

model Freezer {
  id          String   @id @default(cuid())
  name        String
  temperature Int      // -20 or -80 (°C)
  location    String?  // e.g. "Lab Room 2, West Wall"
  notes       String?
  createdAt   DateTime @default(now())

  samples Sample[]
}

model Sample {
  id          String   @id @default(cuid())
  sampleId    String   @unique  // auto-generated e.g. PLA-001
  name        String
  type        String   // PLASMID | LINEAR_DNA | GLYCEROL_STOCK | OTHER
  status      String   @default("ACTIVE") // ACTIVE | USED | DEPLETED | ARCHIVED
  description String?
  notes       String?

  // Storage location
  freezer     Freezer? @relation(fields: [freezerId], references: [id])
  freezerId   String?
  rack        String?
  box         String?
  position    String?  // e.g. A1, B3

  // Linkages
  task          Task?         @relation("SampleTask", fields: [taskId], references: [id])
  taskId        String?
  project       Project?      @relation("SampleProject", fields: [projectId], references: [id])
  projectId     String?
  geneSequence  GeneSequence? @relation("SampleSequence", fields: [geneSequenceId], references: [id])
  geneSequenceId String?

  createdBy   User?   @relation("SampleCreator", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
