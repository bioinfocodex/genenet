{
  "name": "lab-network",
  "version": "0.1.0",
  "description": "Self-hosted lab information system: samples, sequences, protocols and an audit trail, over a SQLite file you own.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bioinfocodex/genenet.git"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test": "node --import ./tests/setup.mjs --test \"tests/**/*.test.ts\"",
    "test:watch": "node --import ./tests/setup.mjs --test --watch \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "docx": "^9.6.1",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "nodemailer": "^8.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "^6.19.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
